# Copy this to .env and edit:
#   cp .env.example .env
DATABASE_URL=mysql+pymysql://root@localhost/campus_mart?unix_socket=/tmp/mysql.sock
# OpenRouter (https://openrouter.ai/keys) — required for Campus AI
OPENROUTER_API_KEY=sk-or-v1-paste-your-key-here
# Free tool-calling default (stable); fallback if rate-limited: nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MODEL=poolside/laguna-s-2.1:free
