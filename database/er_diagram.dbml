// Campus Mart | ER diagram for dbdiagram.io (https://dbdiagram.io)
// HOW: copy-paste this whole file into dbdiagram.io -> Export PNG for report.
// Beginner reading: Table = box, Ref = arrow (FK link), > = many side.

Table Users {
  user_id int [pk, increment]
  name varchar(50) [not null, note: 'WHO: student name']
  university_email varchar(100) [unique, not null, note: 'college mail, one per person']
  password_hash varchar(255) [not null]
  phone varchar(15)
  role varchar(20) [default: 'student', note: 'student | faculty | staff']
  department varchar(50)
  is_verified boolean [default: false]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
}

Table Categories {
  category_id int [pk, increment]
  name varchar(50) [unique, not null, note: 'WHAT shelf: Academic, Electronics...']
  description varchar(255)
}

Table Listings {
  listing_id int [pk, increment]
  seller_id int [not null, note: 'WHO sells -> Users']
  category_id int [not null, note: 'WHAT shelf -> Categories']
  title varchar(100) [not null]
  description text
  price decimal(10,2) [not null, note: 'must be >= 0']
  type varchar(20) [default: 'sale', note: 'sale | rent | service']
  condition varchar(20) [default: 'used']
  status varchar(20) [default: 'active', note: 'active | sold | rented']
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
}

Table Listing_Images {
  image_id int [pk, increment]
  listing_id int [not null, note: 'PHOTO of which item']
  image_url varchar(255) [not null]
  sort_order int [default: 0]
}

Table Rentals {
  rental_id int [pk, increment]
  listing_id int [unique, not null, note: 'only rent items get a row, 1:1']
  price_per_day decimal(10,2) [not null]
  deposit decimal(10,2) [default: 0]
  max_duration_days int
}

Table Conversations {
  conversation_id int [pk, increment]
  listing_id int [not null, note: 'chat about WHICH item']
  buyer_id int [not null, note: 'WHO asks']
  seller_id int [not null, note: 'WHO sells']
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
}

Table Messages {
  message_id int [pk, increment]
  conversation_id int [not null, note: 'message in WHICH chat']
  sender_id int [not null, note: 'WHO said it']
  body text [not null]
  sent_at timestamp [default: `CURRENT_TIMESTAMP`]
  is_read boolean [default: false]
}

// Relationships: 1 = one side, > = many side
Ref: Listings.seller_id > Users.user_id
Ref: Listings.category_id > Categories.category_id
Ref: Listing_Images.listing_id > Listings.listing_id [delete: cascade]
Ref: Rentals.listing_id - Listings.listing_id [delete: cascade]
Ref: Conversations.listing_id > Listings.listing_id [delete: cascade]
Ref: Conversations.buyer_id > Users.user_id [delete: cascade]
Ref: Conversations.seller_id > Users.user_id [delete: cascade]
Ref: Messages.conversation_id > Conversations.conversation_id [delete: cascade]
Ref: Messages.sender_id > Users.user_id [delete: cascade]
